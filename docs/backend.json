
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Nó operacional da rede neural Nexus.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "health": { "type": "number" },
        "activity": { "type": "string" },
        "uptime": { "type": "string" },
        "registeredTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "status"]
    },
    "GeneratedCoin": {
      "title": "GeneratedCoin",
      "type": "object",
      "description": "Ativo digital recém-gerado na Maternidade Nexus.",
      "properties": {
        "id": { "type": "string" },
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "dnaHash": { "type": "string" },
        "supply": { "type": "number" },
        "status": { "type": "string" },
        "mpcSignature": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "symbol", "name"]
    },
    "ProductionEvent": {
      "title": "ProductionEvent",
      "type": "object",
      "description": "Evento de log de alta fidelidade do ecossistema.",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventType": { "type": "string", "enum": ["stable", "info", "critical", "success", "error"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "message": { "type": "string" },
        "sourceComponent": { "type": "string" },
        "agentId": { "type": "string" }
      }
    },
    "MainnetTransaction": {
      "title": "MainnetTransaction",
      "type": "object",
      "description": "Registro de liquidação soberana na Mainnet do Bitcoin.",
      "properties": {
        "txid": { "type": "string" },
        "hex": { "type": "string" },
        "status": { "type": "string" },
        "amount": { "type": "number" },
        "fee_sats": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "message": { "type": "string" },
        "report": { "type": "string" },
        "audit": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "password"]
  },
  "firestore": {
    "/agents/{agentId}": { "schema": "#/backend/entities/Agent", "description": "Registro de agentes ativos." },
    "/generated_coins/{coinId}": { "schema": "#/backend/entities/GeneratedCoin", "description": "Registro de moedas nascidas na maternidade." },
    "/production_events/{eventId}": { "schema": "#/backend/entities/ProductionEvent", "description": "Feed central imutável." },
    "/mainnet_transactions/{txid}": { "schema": "#/backend/entities/MainnetTransaction", "description": "Histórico de liquidação real." },
    "/system_status/global_replication": { "schema": "object", "description": "Monitor de onipresença." }
  }
}
