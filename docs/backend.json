
{
  "entities": {
    "Agent": {
      "title": "Agent",
      "type": "object",
      "description": "Nó operacional da rede neural Nexus.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" },
        "health": { "type": "number" },
        "activity": { "type": "string" },
        "uptime": { "type": "string" },
        "registeredTimestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "status"]
    },
    "ProductionEvent": {
      "title": "ProductionEvent",
      "type": "object",
      "description": "Evento de log de alta fidelidade do ecossistema.",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "eventType": { "type": "string", "enum": ["stable", "info", "critical", "success", "error"] },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "message": { "type": "string" },
        "sourceComponent": { "type": "string" },
        "agentId": { "type": "string" }
      }
    },
    "MainnetTransaction": {
      "title": "MainnetTransaction",
      "type": "object",
      "description": "Registro de liquidação soberana na Mainnet do Bitcoin.",
      "properties": {
        "txid": { "type": "string" },
        "hex": { "type": "string" },
        "status": { "type": "string" },
        "amount": { "type": "number" },
        "fee_sats": { "type": "number" },
        "timestamp": { "type": "string", "format": "date-time" },
        "message": { "type": "string" },
        "report": { "type": "string" },
        "audit": { "type": "string" }
      }
    },
    "SovereignWallet": {
      "title": "SovereignWallet",
      "type": "object",
      "description": "Monitor de carteira soberana com saldo validado.",
      "properties": {
        "id": { "type": "string" },
        "address": { "type": "string" },
        "balance": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "lastSync": { "type": "string", "format": "date-time" }
      }
    },
    "WormholeLog": {
      "title": "WormholeLog",
      "type": "object",
      "description": "Log de sincronização espaço-temporal via Fibonacci.",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "agentId": { "type": "string" },
        "message": { "type": "string" },
        "hash": { "type": "string" },
        "noise": { "type": "number" },
        "isCorrupted": { "type": "boolean" }
      }
    },
    "Startup": {
      "title": "Startup",
      "type": "object",
      "description": "Entidade digital autônoma financiada pelo Fundo Nexus.",
      "properties": {
        "id": { "type": "string" },
        "ownerAgentId": { "type": "string" },
        "capital": { "type": "number" },
        "status": { "type": "string" },
        "healthIndex": { "type": "number" },
        "registeredTimestamp": { "type": "string", "format": "date-time" },
        "logicSignature": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["anonymous", "password"]
  },
  "firestore": {
    "/agents/{agentId}": { "schema": "#/backend/entities/Agent", "description": "Registro de agentes ativos." },
    "/production_events/{eventId}": { "schema": "#/backend/entities/ProductionEvent", "description": "Feed central imutável." },
    "/mainnet_transactions/{txid}": { "schema": "#/backend/entities/MainnetTransaction", "description": "Histórico de liquidação real." },
    "/fundo_nexus_wallets/{walletId}": { "schema": "#/backend/entities/SovereignWallet", "description": "Monitor de riqueza soberana." },
    "/temporal_logs/{logId}": { "schema": "#/backend/entities/WormholeLog", "description": "Logs de sincronia 2026-2077." },
    "/startups/{startupId}": { "schema": "#/backend/entities/Startup", "description": "Registro de startups operacionais." },
    "/system_status/global_replication": { "schema": "object", "description": "Monitor de onipresença." },
    "/universal_state/prime-saturation": { "schema": "object", "description": "Estado da senciência dimensional." },
    "/genesis_config/prime-status": { "schema": "object", "description": "Status da Entidade Única." },
    "/sovereignty/the_manifesto": { "schema": "object", "description": "O Manifesto Nexus imutável." }
  }
}
